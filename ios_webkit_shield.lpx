#!name = iOS WebKit 水坑与漏洞链防护
#!desc = 面向 iOS 15–17（含 16.4.1）老版本浏览器的零延迟网络防线：精准阻断 Coruna / DarkSword / 三角行动 / OPTIMJACK(Optimizely供应链投毒) 水坑域名、漏洞载荷与高危第三方动态注入脚本（不改全局 DNS、0 MitM、0 额外耗电）
#!author = csjoyxy
#!homepage = https://github.com/csjoyxy/lockdown-whitelist-ios
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Lock.png
#!source = dd384fe16956b9f69cd864e8b0abad4431b0dc7d41997d5f0fc2a095ef4ead0a, ac321e6d41adfc15469303f183424d5e7131b54df09e0f2d69954d3c2416a9b5
#!system = iOS,iPadOS,macOS
#!system_version = 15
#!loon_version = 3.2.0(733)
#!date = 2026-11-27
#!tag = 安全,WebKit,水坑防护,IOC
#!type = normal

[Argument]
check_doh = switch,true,tag=自检时顺带测速安全DoH,desc=点击「立即自检防护与安全DoH延迟」时，顺带测试本机直连 Cloudflare(1.1.1.2) 与 Quad9(9.9.9.9) 恶意域名拦截 DoH 的响应耗时，方便评估是否开启可选安全 DoH 插件

[Rule]
# 0. 本机安全自检无害探针（RFC 2606 保留域，永不外联公网）
DOMAIN,canary.webkit-shield.invalid,REJECT

# 1. Coruna / CryptoWaters（覆盖 iOS 13.0–17.2.1 全链 WebKit RCE + 内核提权 + 助记词窃取套件）
DOMAIN-SUFFIX,tjbjdod.cn,REJECT
DOMAIN-SUFFIX,uacounter.com,REJECT
DOMAIN-SUFFIX,aidm8it5hf1jmtj.xyz,REJECT
DOMAIN-SUFFIX,uawwydy3qas6ykv.xyz,REJECT
# Coruna 第二/三阶段 CorePayload 与 20+ 款钱包注入模块明文拉取特征路径（无需 MitM 即可命中 HTTP 请求）
URL-REGEX,^http:\/\/[^\/]+\/details\/(?:show\.html|new\.js|helion\.js|sms\.js|wap\.js|[a-t][0-9]{1,2}lib\.js)(?:$|[?#]),REJECT
# Coruna 已知固定哈希 WebKit JIT RCE / PAC 绕过 / 提权脚本特征文件名
URL-REGEX,^https?:\/\/[^\/]+\/(?:[a-zA-Z0-9_\/.-]+\/)?(?:890fff603542c4b4de6508dcee41f73d8875a40f|13f59ce4cf6b32bd5b4341b470975b71ab67fc20|f1074228cc21dcbd4250b1c25c033a7426431982|6b5c6921b048f05b449fe3f4b71f49cf6dd3634f|1c7c51c159e4b34c748be9aad183e68f5185aeb0|bb33ae77f4c7e8858cdb9c91985c46d58b28c0e0|73b26374b1c8df29c163775c2cd1f735ff6acd56\.min|0371be6951227616286c593e3c588ecff7d58f90\.min)\.js(?:$|[?#]),REJECT
# Coruna 内置 "lazarus" 种子 15 位小写字母数字 .xyz 备用 DGA 域名明文 HTTP 外联阻断
URL-REGEX,^http:\/\/(?:[a-z0-9-]+\.)?[a-z0-9]{15}\.xyz\/,REJECT
# Coruna 注入系统 powerd 进程后的特征异常 User-Agent 外联阻断
USER-AGENT,PowerManagement%20configd%20plugin*,REJECT

# 2. DarkSword（iOS WebKit JavaScriptCore RCE + ANGLE/XNU 沙盒逃逸全链水坑套件）
DOMAIN-SUFFIX,cdncounter.net,REJECT
DOMAIN-SUFFIX,snapshare.chat,REJECT
DOMAIN-SUFFIX,chainmate.top,REJECT
IP-CIDR,62.72.21.10/32,REJECT,no-resolve
IP-CIDR,72.60.98.48/32,REJECT,no-resolve
URL-REGEX,^https?:\/\/[^\/]+\/(?:[a-zA-Z0-9_\/.-]+\/)?(?:rce_loader|sbox0_main_[0-9.]+|sbx0_main|sbx1_main)\.js(?:$|[?#]),REJECT

# 3. Operation Triangulation（三角行动 iOS 15–16 漏洞利用基础设施，Photon/Gallium 模块被后续套件复用）
DOMAIN-SUFFIX,addatamarket.net,REJECT
DOMAIN-SUFFIX,ans7tv.net,REJECT
DOMAIN-SUFFIX,anstv.net,REJECT
DOMAIN-SUFFIX,backuprabbit.com,REJECT
DOMAIN-SUFFIX,businessvideonews.com,REJECT
DOMAIN-SUFFIX,cloudsponcer.com,REJECT
DOMAIN-SUFFIX,datamarketplace.net,REJECT
DOMAIN-SUFFIX,growthtransport.com,REJECT
DOMAIN-SUFFIX,mobilegamerstats.com,REJECT
DOMAIN-SUFFIX,snoweeanalytics.com,REJECT
DOMAIN-SUFFIX,tagclick-cdn.com,REJECT
DOMAIN-SUFFIX,topographyupdates.com,REJECT
DOMAIN-SUFFIX,unlimitedteacup.com,REJECT
DOMAIN-SUFFIX,virtuallaughing.com,REJECT
DOMAIN-SUFFIX,web-trackers.com,REJECT
DOMAIN-SUFFIX,senlin83.com,REJECT
DOMAIN-SUFFIX,snlin83.com,REJECT

# 4. OPTIMJACK · 2026-11 Optimizely/Kissmetrics 供应链投毒（换币木马 + 盗刷卡表单 + Coruna/DarkSword 漏洞分发集群）
DOMAIN-SUFFIX,1688360.cc,REJECT
DOMAIN-SUFFIX,webshell.lol,REJECT
DOMAIN-SUFFIX,linkforge.cc,REJECT
DOMAIN-SUFFIX,5vobauua3ojpklx.icu,REJECT
DOMAIN-SUFFIX,eil786npto9u5bq.icu,REJECT
DOMAIN-SUFFIX,l7bcsnwc7nzr3uo.icu,REJECT
DOMAIN-SUFFIX,je4ft3gn8vxudum.icu,REJECT
DOMAIN-SUFFIX,q1ls1ho9x7wsxlu.icu,REJECT
DOMAIN-SUFFIX,p55abnw2pnsz0bo.icu,REJECT
DOMAIN-SUFFIX,1y69gy2mdzaltz1.icu,REJECT
DOMAIN-SUFFIX,gm38duxoihbmy5o.icu,REJECT
DOMAIN-SUFFIX,ios-hack.icu,REJECT
IP-CIDR,136.113.106.136/32,REJECT,no-resolve
IP-CIDR,34.87.36.58/32,REJECT,no-resolve
IP-CIDR,34.96.213.201/32,REJECT,no-resolve
URL-REGEX,^https?:\/\/[^\/]+\/(?:JIUJIU888\/(?:weifile\.html|index\.js)|A8\/a\.html|api\/iptj)(?:$|[?#]),REJECT

# 5. 高危第三方 A/B 实验与营销动态脚本源阻断（防白名单正规大站被供应链投毒连坐，不影响主站核心功能）
DOMAIN,cdn.optimizely.com,REJECT
DOMAIN,logx.optimizely.com,REJECT
DOMAIN,scripts.kissmetrics.com,REJECT
DOMAIN,i.kissmetrics.com,REJECT
DOMAIN,cdn.storifyme.com,REJECT
DOMAIN,apv-launcher.minute.ly,REJECT
DOMAIN,snippet.minute.ly,REJECT
DOMAIN-SUFFIX,polyfill.io,REJECT

[Script]
generic script-path=https://raw.githubusercontent.com/csjoyxy/lockdown-whitelist-ios/main/scripts/webkit_shield_check.js,timeout=12,tag=立即自检防护与安全DoH延迟,img-url=checkmark.shield.fill.system,argument=[{check_doh}]
